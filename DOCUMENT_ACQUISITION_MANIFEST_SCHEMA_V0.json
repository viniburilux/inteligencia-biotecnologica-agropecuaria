{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lux-lab://document-acquisition-v0/acquisition-manifest.schema.json",
  "title": "Document Acquisition V0 Manifest",
  "type": "object",
  "required": [
    "document_id", "identifier", "document_type", "source", "source_url",
    "attempted_at", "adapter", "acquisition_status", "access_status",
    "format", "size_bytes", "sha256", "storage_status",
    "redistribution_status", "provenance"
  ],
  "properties": {
    "document_id": {"type": "string"},
    "identifier": {"type": "string"},
    "document_type": {"type": "string", "enum": ["patent", "paper", "unknown"]},
    "family_or_relation": {"type": ["object", "null"]},
    "source": {"type": "string"},
    "source_url": {"type": ["string", "null"], "format": "uri"},
    "attempted_at": {"type": "string", "format": "date-time"},
    "adapter": {"type": "string"},
    "acquisition_status": {"type": "string"},
    "access_status": {"type": "string"},
    "access_status_detail": {"type": ["string", "null"]},
    "content_type": {"type": ["string", "null"]},
    "format": {"type": ["string", "null"]},
    "size_bytes": {"type": ["integer", "null"], "minimum": 0},
    "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "storage_status": {"type": "string"},
    "stored_path": {"type": ["string", "null"]},
    "redistribution_status": {"type": "string"},
    "identity_status": {"type": "string"},
    "identity_value": {"type": ["string", "null"]},
    "technical_content_status": {"type": "string"},
    "contains_description": {"type": ["boolean", "null"]},
    "contains_claims": {"type": ["boolean", "null"]},
    "sections_locatable": {"type": ["boolean", "null"]},
    "extracted_text_path": {"type": ["string", "null"]},
    "extracted_text_chars": {"type": ["integer", "null"], "minimum": 0},
    "evidence_checks": {"type": "array"},
    "discovery_metadata": {"type": "object"},
    "error": {"type": ["object", "null"]},
    "provenance": {"type": "object"}
  }
}
